# Ollama Configuration
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MODEL_CHAT=gemma3n:e4b

# Модель эмбеддингов. Обязательна и умолчания НЕ имеет.
#
# Имя коллекции ChromaDB выводится из этого значения, а ChromaDB на незнакомое
# имя коллекции не отказывает, а создаёт пустую: неверная (или подставленная
# по умолчанию) модель означает пустой поиск при полной базе и ни одной ошибки
# в логах. Поэтому порядок такой: runtime_settings.json -> эта переменная ->
# честный отказ 503 (settings.embedding_model_unset) на всех RAG-операциях.
# Приложение при этом стартует, и модель можно выбрать в админ-панели.
#
# Ставьте ТУ модель, которой считали векторы: смена требует переиндексации
# (POST /api/v1/documents/reindex). Строка ниже — пример, а не умолчание:
# раскомментируйте и подставьте своё.
# OLLAMA_MODEL_EMBEDDING=qwen3-embedding:8b
OLLAMA_MODEL_EMBEDDING=

# Database Configuration
POSTGRES_USER=andozai_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=andozai_db

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-change-in-production

# JWT Settings
# Access-токен короткий: отозвать его можно только через token_version.
# Долгую сессию держит refresh-токен, он ротируется при каждом обновлении.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Кому верить в X-Forwarded-For / X-Real-IP при подсчёте лимитов.
# Только loopback по умолчанию (nginx на том же хосте).
# Для docker-compose добавить подсеть контейнеров, например 172.16.0.0/12.
TRUSTED_PROXIES=127.0.0.1,::1

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=data/chroma

# CORS Origins (comma-separated)
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ORIGINS=*

# Environment
ENVIRONMENT=development
